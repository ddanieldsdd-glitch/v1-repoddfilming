# Copia a .env.local para desarrollo local.
# En Vercel: Settings → Environment Variables.

# MongoDB Atlas (obligatorio para que /api/content y /api/og lean de la base de datos)
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/?appName=myapp
DB_NAME=ddp_portfolio

# Autenticación del panel /admin (obligatorio — sin esto el login siempre falla)
# Valor: la contraseña que usarás para entrar en /admin
ADMIN_PASSWORD=

# Secreto para firmar los JWT de sesión del admin
# Genera uno con: node -e "require('crypto').randomBytes(48).toString('hex').split('').join('')" | head -c 96
JWT_SECRET=

# Cloudinary — subida de imágenes desde /admin (obligatorio para "Subir archivo")
# Cloud name visible en tus URLs: res.cloudinary.com/<CLOUDINARY_CLOUD_NAME>/...
CLOUDINARY_CLOUD_NAME=dsphxo7mx
# Dashboard Cloudinary → Settings → Access Keys
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
